# Python and editor state
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.idea/
.vscode/

# Model weights and large generated media are never versioned.
*.pt
*.pth
*.ckpt
*.onnx
*.mp4
*.avi
*.mov
*.mkv
*.webm
*.gif

# forNX contains packaged runtime assets that must stay local.
forNX/data/
forNX/pretrained_cache/
forNX/weights/

# Generated experiment artifacts are ignored by default.
output/**
outputs/**
!output/
!outputs/
!output/**/
!outputs/**/
!output/**/*.csv
!output/**/*.json
!output/**/*.log
!output/**/*.txt
!outputs/**/*.csv
!outputs/**/*.json
!outputs/**/*.log
!outputs/**/*.txt
!outputs/**/*.png

# Common local runtime artifacts
wandb/
runs/
tensorboard/
*.tmp
*.bak

# Model checkpoints / pretrained weights
v36-exp/outputs/**/checkpoints/*.pt
v36-exp/outputs/**/*.pth
v36-exp/outputs/**/*.pt

# Bearing-UAV external repos, virtualenvs and downloaded model caches.
v39_otherdata/external/
**/.venv/
**/venv/
**/hf_cache/
**/torch_cache/
**/huggingface/

# Large Bearing-UAV runtime caches. Keep compact CSV/JSON/JPG results elsewhere.
v39_otherdata/generated/route_baseline_cache/
v39_otherdata/generated/native_m2t_cache/
v39_otherdata/generated/native_four_rst_cache/
v39_otherdata/generated/native_m2t_baselines/**/checkpoint.pt
v39_otherdata/generated/native_four_rst_baselines/**/checkpoint.pt
